{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "data/schemas/valuation.json",
  "title": "Supplier valuation feed",
  "description": "供应商财务/估值（时效数据）契约。由 tools/output/supplier_analysis.json 归一化而来。",
  "type": "object",
  "required": ["meta", "data"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["dataset", "version", "generated"],
      "properties": {
        "dataset": { "const": "valuation" },
        "version": { "type": "integer" },
        "schema_ref": { "type": "string" },
        "generated": { "type": "string", "format": "date" },
        "valid_until": { "type": "string", "format": "date" },
        "sources": { "type": "array", "items": { "type": "string" } },
        "build": {
          "type": "string",
          "description": "构建版本戳（流派 B：git describe 派生，如 v1.3.0-5-gabcdef0）。可选，缺省为空。"
        }
      }
    },
    "data": {
      "type": "object",
      "required": ["suppliers"],
      "properties": {
        "suppliers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id"],
            "properties": {
              "id": { "type": "string" },
              "ticker": { "type": ["string", "null"] },
              "category": { "type": "string" },
              "market_cap_usd_b": { "type": ["number", "null"] },
              "pe": { "type": ["number", "null"] },
              "pb": { "type": ["number", "null"] },
              "ev_ebitda": { "type": ["number", "null"] },
              "as_of": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
